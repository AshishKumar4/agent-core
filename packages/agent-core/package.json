{
  "name": "@agent-core/core",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./actors": {
      "types": "./dist/actors/index.d.ts",
      "import": "./dist/actors/index.js"
    },
    "./authority": {
      "types": "./dist/authority-public.d.ts",
      "import": "./dist/authority-public.js"
    },
    "./agents/runs": {
      "types": "./dist/agents/runs/index.d.ts",
      "import": "./dist/agents/runs/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "import": "./dist/content/index.js"
    },
    "./definition": {
      "types": "./dist/definition/index.d.ts",
      "import": "./dist/definition/index.js"
    },
    "./facets": {
      "types": "./dist/facets-public.d.ts",
      "import": "./dist/facets-public.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "import": "./dist/identity/index.js"
    },
    "./environment-provider": {
      "types": "./dist/environments/public.d.ts",
      "import": "./dist/environments/public.js"
    },
    "./invocations": {
      "types": "./dist/invocations/index.d.ts",
      "import": "./dist/invocations/index.js"
    },
    "./mediation": {
      "types": "./dist/mediation-public.d.ts",
      "import": "./dist/mediation-public.js"
    },
    "./operations": {
      "types": "./dist/operations/index.d.ts",
      "import": "./dist/operations/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/public.d.ts",
      "import": "./dist/protocol/public.js"
    },
    "./slate-provider": {
      "types": "./dist/slates/public.d.ts",
      "import": "./dist/slates/public.js"
    },
    "./substrates/sqlite": {
      "types": "./dist/substrates/sqlite/index.d.ts",
      "import": "./dist/substrates/sqlite/index.js"
    }
  },
  "scripts": {
    "check:types": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src test scripts",
    "test": "vitest run",
    "test:p0": "vitest run --tagsFilter p0",
    "test:p1": "vitest run --tagsFilter p1",
    "test:p2": "vitest run --tagsFilter p2",
    "test:quality": "vitest run --config vitest.quality.config.mjs",
    "test:governance": "vitest run --config vitest.governance.config.mjs",
    "test:coverage": "vitest run --coverage",
    "build": "node ./scripts/build.mjs",
    "quality": "node ./scripts/quality/run.mjs",
    "check:architecture": "node ./scripts/quality/architecture.mjs --stage building",
    "check:coherence": "node ./scripts/quality/coherence.mjs --stage building",
    "check:tslean-consumer": "node ./scripts/quality/tslean-consumer.mjs --stage building",
    "check:proof-repair-ledger": "node ./scripts/quality/proof-repair-ledger.mjs --stage building",
    "regenerate:tslean": "node ./scripts/quality/tslean-consumer.mjs --stage building --regenerate",
    "regenerate:tslean:write": "node ./scripts/quality/tslean-consumer.mjs --stage building --regenerate-into-tree",
    "check:conformance": "node ./scripts/quality/run.mjs --stage building --target conformance",
    "check:imports": "node ./scripts/check-import-boundaries.mjs",
    "check:records": "node ./scripts/quality/records.mjs --stage building",
    "check:exports": "node ./scripts/quality/run.mjs --stage building --target exports",
    "check:coverage": "node ./scripts/quality/run.mjs --stage building --target coverage",
    "check:doctrine": "node ./scripts/check-normative.mjs && node ./scripts/quality/doctrine.mjs && node ./scripts/quality/claims.mjs && node ./scripts/quality/backlog.mjs --check",
    "check:mutation": "node ./scripts/quality/mutation.mjs --gate",
    "check:normative": "node ./scripts/check-normative.mjs",
    "check:test-priorities": "node ./scripts/quality/run.mjs --stage building --target test-priorities",
    "check:service-contracts": "node ./scripts/check-service-contracts.mjs",
    "check:substrate-contracts": "node ./scripts/check-substrate-contracts.mjs",
    "check:traceability": "node ./scripts/check-traceability.mjs",
    "check:implementation": "node ./scripts/quality/run.mjs --stage building --target ledger",
    "check:final": "node ./scripts/quality/run.mjs --stage final",
    "check:hermetic": "node ./scripts/quality/run.mjs --stage hermetic",
    "backlog:update": "node ./scripts/quality/backlog.mjs --write"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/instrumenter": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^26.0.1",
    "@types/semver": "7.7.1",
    "@vitest/coverage-v8": "4.1.9",
    "fast-check": "^4.9.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm-strikethrough": "2.0.0",
    "mdast-util-gfm-table": "2.0.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-table": "2.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.0",
    "vitest": "4.1.9",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-json-patch": "3.1.1",
    "semver": "7.8.5"
  }
}
