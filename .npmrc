# Without this file an install inherits whatever ~/.npmrc, $XDG userconfig or NPM_CONFIG_*
# says, so the posture pnpm-workspace.yaml states is not the posture a developer machine
# runs. Each setting below is the reviewed value, and scripts/quality/supply-chain.mjs
# requires every one of them exactly.
#
# ignore-scripts stays false on purpose: with scripts ignored pnpm never inspects a
# dependency's lifecycle scripts, so strictDepBuilds has nothing left to fail on and an
# unruled script arrives silently. Dependency scripts stay blocked by
# `onlyBuiltDependencies: []`, and the supply-chain gate forbids install-time lifecycle
# scripts in this repository's own manifests, so an inspected script has nothing to run.
# Hook code is refused separately: ignore-pnpmfile keeps pnpm from loading a pnpmfile at all.
ignore-scripts=false
ignore-pnpmfile=true
verify-store-integrity=true
lockfile=true
ignore-workspace=false
package-manager-strict=true
package-manager-strict-version=true
